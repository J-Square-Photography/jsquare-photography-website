# Google Business Profile API — Client Stories live review sync
# Full walkthrough: ../GOOGLE_REVIEWS_INTEGRATION.md
# Copy this file to .env.local and fill in the values below.

# Cloud Console → APIs & Services → Credentials →
# "J Square Website - Reviews Sync" OAuth client
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# One-time only: with `npm run dev` running, visit
# http://localhost:3000/api/google-reviews/authorize, sign in as the
# jsquarephotographysg@gmail.com business account, and copy the refresh_token
# shown on the callback page into this value.
GOOGLE_OAUTH_REFRESH_TOKEN=

# Format: accounts/{accountId}/locations/{locationId}
# Find it by running: npm run sync:list-locations
GOOGLE_BUSINESS_LOCATION=
